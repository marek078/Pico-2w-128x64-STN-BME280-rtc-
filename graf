set datafile separator ","
set autoscale fix
#okey

set xdata time
set timefm "%Y/%m/%d %H:%M:%S"
set format x "%H:%M:%S"


set style line 100 lt 1 lc rgb "grey" lw 1 # linestyle for the grid
set grid ls 100 # enable grid with specific linestyle

set title "zobrazovacie zariadenie"
set key font "Arial Bold"

set size 1,1
set origin 0,0
set multiplot layout 2,2

plot 'test_data.csv' using 1:2 with lines title "Teplota °C" lc rgb "#F50048" lw 4
plot 'test_data.csv' using 1:3 with lines title "Tlak"
plot 'test_data.csv' using 1:4 with lines title "Vlhkosť"
unset multiplot
pause -1 
